# LoL Coach -- environment. Copy to `.env` and edit as needed.
# `.env` is gitignored; never commit real keys.

# --- service ---
LOL_COACH_SERVICE=lol-coach
LOG_LEVEL=DEBUG

# --- data ---
# Defaults to <repo>/data. Four databases are created: snapshot.db (OP.GG),
# executions.db (workflow history), chat.db (chat sessions + agent memory), and
# eval.db (agent evaluation run history).
# LOL_COACH_DATA_DIR=
# LOL_COACH_SNAPSHOT_DB=
# LOL_COACH_EXECUTIONS_DB=
# LOL_COACH_CHAT_DB=
# LOL_COACH_EVAL_DB=

# --- OP.GG MCP (no auth required) ---
LOL_COACH_OPGG_MCP_URL=https://mcp-api.op.gg/mcp
# Seconds between per-champion requests during a fetch (be polite).
LOL_COACH_FETCH_INTERVAL=1.2

# --- agent + narrator (LLM) ---
# The agent adapts fuzzy input, orchestrates the deterministic tools, and
# narrates results. It NEVER decides picks. Chat requires a model: with no
# provider configured POST /api/agent/chat returns 503, and if the provider
# fails at the Think step the run is marked failed with no answer. The engine,
# the board, and the Trace Inspector still work with no key.
# Copy this file to `.env`; the app loads `.env` with override=True, so values
# here win over anything already set in your shell.
LOL_COACH_LLM_PROVIDER=anthropic
# Defaults per provider: anthropic -> claude-sonnet-5, openai -> gpt-4o.
# LOL_COACH_LLM_MODEL=claude-sonnet-5
# API endpoint override. Leave unset to use the provider's real API; the app does
# NOT inherit ANTHROPIC_BASE_URL/OPENAI_BASE_URL from the shell.
# LOL_COACH_LLM_BASE_URL=
# Extra request headers, as a JSON object. Needed by some gateways/proxies, e.g.
# a local OpenCode gateway: {"x-opencode-session":"lol-coach"}
# LOL_COACH_LLM_EXTRA_HEADERS=
# Max tool-loop round-trips before the agent stops (default 8).
# LOL_COACH_MAX_TOOL_CALLS=8
# Max questions (user turns) per chat session; further questions get HTTP 409
# until a new session is started (default 5).
# LOL_COACH_MAX_QUESTIONS=5
# Allow image (draft screenshot) input; requires a key (default true).
# LOL_COACH_ENABLE_VISION=true

# --- live lookups (agent tools that hit the network mid-run) ---
# `get_summoner_profile` (rank/LP/record for a Riot ID) and
# `get_lane_matchup_guide` (a written tip for one specific lane matchup) are the
# only tools that call out during a chat run. Everything else - the engine, the
# reference data - is offline. With these off, the two tools are not even
# advertised to the model.
# LOL_COACH_ENABLE_LIVE_TOOLS=true
# Default server region for a Riot ID lookup when the model doesn't supply one.
# LOL_COACH_LIVE_REGION=NA
# Per-request timeout, in seconds (short: a chat turn is waiting).
# LOL_COACH_LIVE_TIMEOUT=15
# How long a lookup is reused, in seconds. A follow-up question usually re-asks
# the same thing within seconds.
# LOL_COACH_LIVE_CACHE_TTL=300
# Minimum seconds between two live calls (politeness gate; the provider is a
# process-wide singleton, so this holds across requests).
# LOL_COACH_LIVE_MIN_INTERVAL=0.25
# Paste your key here. NOTE: because .env wins over the shell, an *empty*
# assignment (ANTHROPIC_API_KEY=) would CLEAR a key you exported in your shell,
# so leave the line commented out unless you are setting a real value.
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# --- maintenance agents (issue-fix / pr-review) ---
# Two workflows that work this repo's own backlog: the fixer investigates a
# labelled issue, edits a checkout, verifies it, and opens a PR; the reviewer
# submits APPROVE or REQUEST_CHANGES. They are NOT part of the coach product --
# their UI is the separate admin surface at /admin (API under /api/admin/*).
# Both need a model (above) and an authenticated `gh` CLI. Guardrails are
# deterministic checks in the workflow, not prompts: see docs/MAINTENANCE_AGENTS.md.
# Default `owner/name` for --repo.
# LOL_COACH_GITHUB_REPO=
# The fixer acts only on an issue carrying this label. ONLY A HUMAN APPLIES IT --
# that label is the gate against acting on an untrusted issue body.
# LOL_COACH_AGENT_ISSUE_LABEL=agent-fix
# The PR's base branch, and the branch the agent creates for its own commit.
# LOL_COACH_AGENT_BASE_BRANCH=main
# LOL_COACH_AGENT_BRANCH_PREFIX=agent/issue
# Comma-separated verify commands; the run is blocked if any fails.
# LOL_COACH_AGENT_VERIFY_COMMANDS=ruff check .,mypy src,python -m pytest -q
# Comma-separated paths the fixer may never change; a change under any of them
# aborts the run.
# LOL_COACH_AGENT_DENIED_PATHS=.github/workflows,.env
# Tool-loop budget for the coding model (default 12).
# LOL_COACH_AGENT_LOOP_ROUNDS=12
# A human merges by default: the reviewer submits a review and stops. Set this
# true to let an approval also merge -- only do so deliberately.
# LOL_COACH_AGENT_AUTO_MERGE=false

# --- AI observability (Langfuse) ---
# Optional. When a public *and* secret key are set, every agent run is recorded
# in Langfuse as one trace: each Think and narration call's prompt, completion,
# tool calls, token usage, and cost, grouped by chat session. With no keys (or
# with the package uninstalled) tracing is a no-op and the app is unchanged.
# Start a local server with `bash scripts/langfuse.sh up`; the values below match
# the key that stack provisions on first boot.
# LANGFUSE_PUBLIC_KEY=pk-lf-lolcoach-local
# LANGFUSE_SECRET_KEY=sk-lf-lolcoach-local
# LANGFUSE_HOST=http://localhost:3000
# Optional environment label for traces in the Langfuse UI (default: unset).
# LANGFUSE_TRACING_ENVIRONMENT=local
#
# Maintenance agents (issue-fix / pr-review / eval-agents) trace to a SEPARATE
# Langfuse project — create one in the UI and paste its keys here. They do not
# fall back to the app keys above, so app traces never mix with agent traces.
# The host and environment fall back to the app values when omitted.
# LANGFUSE_AGENT_PUBLIC_KEY=pk-lf-lolcoach-agents
# LANGFUSE_AGENT_SECRET_KEY=sk-lf-lolcoach-agents
# LANGFUSE_AGENT_HOST=http://localhost:3000
# LANGFUSE_AGENT_TRACING_ENVIRONMENT=local

# --- frontend (dev CORS origin) ---
LOL_COACH_FRONTEND_URL=http://localhost:5173
